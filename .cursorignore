# Hard-block AI access (Agent, Tab, @-mentions). .gitignore alone only affects indexing.
# See https://cursor.com/docs/reference/ignore-file

# Secrets — allow the documented template
.env
.env.*
!.env.example

# Local overrides (Vite *.local env files)
*.local

# Local / infra config (gitignored)
.cursor/mcp.json
scripts/infra/r2-cors.json

# Build output
dist/
dist-ssr/

# Local tool / review state
.review-loop/
.cursor/review-lock.json
.cursor/review-loop/
.cursor/hooks/state/

# Python cache from Cursor hooks tests
__pycache__/
.pytest_cache/

# Supabase CLI temp
supabase/.temp/
