{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": ".cursor/hooks/run-python.sh review_loop_budget.py"
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/run-python.sh review_loop_round.py",
        "loop_limit": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/run-python.sh review_loop_git_guard.py",
        "failClosed": true
      }
    ]
  }
}
